{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EhViewer for Windows 11",
  "version": "0.1.0",
  "identifier": "com.ehviewer.windows11",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EhViewer for Windows 11",
        "width": 1000,
        "height": 720,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#1b1d22"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: ehimg: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://localhost:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}


